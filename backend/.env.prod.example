# Copie para backend/.env.prod.local e preencha (não versionar).
# Ou rode: ./scripts/use-stack.sh prod  (usa o .env.prod.local já preenchido)

PORT=3333
DATABASE_URL="postgresql://USER:PASSWORD@HOST/financial_control?sslmode=require"
JWT_SECRET=same-as-render-production
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000
SWAGGER_ENABLED=true
# Evite ligar Telegram no backend local contra produção (conflito de webhook)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
