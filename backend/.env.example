# Backend env — deixe ativo só UM bloco de DATABASE_URL / JWT_SECRET.

PORT=3333
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000,http://localhost:3001
SWAGGER_ENABLED=true

# --- LOCAL (Docker) ---
DATABASE_URL="postgresql://financial_control:financial_control@localhost:5432/financial_control?schema=public"
JWT_SECRET=change-this-to-a-long-random-local-secret

# --- PRODUÇÃO (Neon / mesmos segredos do Render) ---
# Descomente e comente o bloco LOCAL para usar o banco de produção.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/financial_control?sslmode=require"
# JWT_SECRET=same-as-render-production

TELEGRAM_ENABLED=false
# Obrigatórios apenas quando TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
